[Unit]
Description=NEON AIR - PWA de calidad del aire SIATA (Flask + gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/neon-air
Environment="BIND=0.0.0.0:8000"
Environment="PYTHONUNBUFFERED=1"
# TLS directo en gunicorn, sin proxy. Lo llena deploy/self_signed_cert.sh con
# --certfile y --keyfile; vacio significa HTTP plano.
Environment="TLS_ARGS="
# Para servir directo en la IP publica sin puerto (http://<ip>/), cambia el BIND
# de arriba a 0.0.0.0:80 y descomenta la linea siguiente: sin esa capacidad un
# proceso que no es root no puede tomar un puerto por debajo de 1024.
#AmbientCapabilities=CAP_NET_BIND_SERVICE
# UN SOLO worker con varios hilos, a proposito. Cada worker es un proceso
# independiente: con dos, cada uno corre su propio ETL y carga su propia copia
# del historico en pandas (cientos de MB), lo que en una t2.micro de 1 GB
# termina con el OOM killer matando un worker a mitad de una respuesta. Con un
# worker, el estado del pipeline se comparte y los hilos cubren la concurrencia,
# que para esta app es de lectura y poca.
ExecStart=/opt/neon-air/.venv/bin/gunicorn \
    --workers 1 \
    --threads 8 \
    --timeout 180 \
    --bind $BIND \
    $TLS_ARGS \
    --access-logfile - \
    --error-logfile - \
    app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
